{
  "name": "@cornerways/design",
  "version": "0.7.0",
  "private": true,
  "description": "The shared Cornerways shell: design tokens, fonts, layout modes, header and controls, used by every *.cornerways.io site.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./telemetry": "./src/telemetry.ts",
    "./auth": "./src/auth.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./base.css": "./src/base.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "preview": "vite --open /preview-site/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "lucide-react": ">=1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "hono": "^4.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "hono": "^4.13.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.12"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  }
}
